      "atom_kind": "method",
      "canonical_statement": "The case investigation included a conjunctival swab obtained before antibiotic treatment, a repeat conjunctival swab, additional infant nasal and umbilical swabs, and MRSA screening of both parents.",
      "assertion_origin": "normalized_from_source",
      "source_anchor": {
        "section": "methods",
        "page": "794",
        "paragraph": "Case report, microbiology and household screening",
