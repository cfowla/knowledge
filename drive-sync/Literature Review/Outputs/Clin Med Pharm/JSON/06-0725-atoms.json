  {
    "atom_id": "56bf0738-1ae1-49fd-8a75-0df953321da2",
    "publication_id": "bef32176-2262-453c-be3e-76b7c786c0ed",
    "atom_kind": "author_conclusion",
    "canonical_statement": "Because the owner and infected cat carried indistinguishable isolates, the authors considered interspecies household transmission likely, but they could not determine the direction of transmission from the sampling timeline.",
    "assertion_origin": "normalized_from_source",
    "source_anchor": {
      "section": "discussion",
      "page": "1999",
      "paragraph": null,
      "sentence": null,
      "table": null,
      "table_row": null,
      "table_column": null,
      "figure": null,
      "supplement": null,
      "character_start": null,
      "character_end": null,
      "verbatim_excerpt": "Because indistinguishable isolates were collected from the owner and the infected cat, MRSA likely was transmitted between species in the household. However, while it is tempting to assume that the owner was the source of infection because of the owner’s previous history of a soft tissue infection, this cannot be definitively determined on the basis of the timing of sampling in this case.",
      "excerpt_hash": null
    },
    "provenance": {
